# Tripwire never commits real credentials. Copy this file to .env for local use.
TRIPWIRE_ENVIRONMENT=local
TRIPWIRE_ARTIFACT_DIR=artifacts/runtime
TRIPWIRE_DEMO_DIR=demo/fraud
TRIPWIRE_DATAHUB_GMS_URL=http://localhost:8080
TRIPWIRE_DATAHUB_FRONTEND_URL=http://localhost:9002
TRIPWIRE_DATAHUB_TOKEN=
# The defaults launch the locked mcp-server-datahub package with the active Python.
# Override these only when using a separately managed MCP executable.
# TRIPWIRE_MCP_COMMAND=C:\path\to\python.exe
# TRIPWIRE_MCP_ARGS=["-m","mcp_server_datahub"]
TRIPWIRE_MCP_TIMEOUT_SECONDS=30

# Only needed for `tripwire github publish`; GitHub Actions supplies these automatically.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository
GITHUB_SHA=
